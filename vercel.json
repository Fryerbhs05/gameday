{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/push/cron",
      "schedule": "*/5 14-18 * * 0"
    },
    {
      "path": "/api/push/status?job=thu",
      "schedule": "*/5 11-21 * * 3-6"
    },
    {
      "path": "/api/push/td",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/push/status?job=snf",
      "schedule": "*/5 2-8 * * 1"
    },
    {
      "path": "/api/push/status?job=mnf",
      "schedule": "* 16-23 * * 1"
    },
    {
      "path": "/api/push/status?job=mnf&late=1",
      "schedule": "* 0-3 * * 2"
    },
    {
      "path": "/api/push/status?job=tue",
      "schedule": "0 * * * 2"
    }
  ],
  "functions": {
    "api/push/td.js": {
      "maxDuration": 60
    },
    "api/push/status.js": {
      "maxDuration": 300
    },
    "api/push/subscribe.js": {
      "maxDuration": 60
    }
  }
}
